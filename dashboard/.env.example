# API サーバーのベース URL（末尾スラッシュなし）
VITE_API_BASE_URL=https://cyberattack-info-api.onrender.com

# X-API-KEY 認証キー（読み取り専用）
# !! 注意: ここに設定した値はビルド成果物としてブラウザに配信され、誰でも抽出できる。
# 管理者用の API_KEY(バックエンドの /admin/* を保護するキー)を絶対に設定しないこと。
# バックエンドの PUBLIC_API_KEY と同じ値を設定する。
VITE_PUBLIC_API_KEY=your-public-read-only-api-key-here
