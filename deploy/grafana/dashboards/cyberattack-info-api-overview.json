      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "increase(rate_limit_rejected_total[1h])",
          "legendFormat": "レート制限で拒否",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "increase(auth_lockouts_total[1h])",
          "legendFormat": "ロックアウト",
          "refId": "B"
