{
  "title": "サイバー攻撃情報API",
  "uid": "cyberattack-info-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["cyberattack-info-api"],
  "panels": [
    {
      "id": 1,
      "title": "クローラー実行結果（直近、1=成功/0=エラー）",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "crawler_last_run_success",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "エラー", "color": "red" }, "1": { "text": "成功", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 2,
      "title": "最終実行からの経過時間（分）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "(time() - crawler_last_run_timestamp_seconds) / 60",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "m" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "クローラー所要時間（秒）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "crawler_last_run_duration_seconds",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "クローラー新規挿入件数",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "crawler_last_run_inserted",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "クローラー更新・削除件数",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "crawler_last_run_updated",
          "legendFormat": "{{crawler_type}} 更新",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "crawler_last_run_deleted",
          "legendFormat": "{{crawler_type}} 削除",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU使用率（api-prod）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "rate(process_cpu_seconds_total{job=\"api-prod\"}[5m]) * 100",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "プロセスメモリ使用率（api-prod、ホスト全体に対する割合）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "process_resident_memory_bytes{job=\"api-prod\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"} * 100",
          "legendFormat": "メモリ %",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 8,
      "title": "ストレージ使用率（OCIホスト、ルートファイルシステム）",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "legendFormat": "ディスク使用率 %",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 9,
      "title": "外部API呼び出しのリトライ発生回数（1時間あたり、要因別）",
      "description": "CISA KEV・OSV・MyJVN・GitHub API呼び出しが一時的エラー（5xx・接続断）や\nレート制限（429・GitHub二次レート制限の403）でリトライされた回数。恒久的な\nエラー（401/403〈権限不足〉/404等）はリトライされないため含まれない\n（Issue #130、app.core.retry参照）。増加傾向が続く場合は外部API側の障害や\nレート制限の恒常的な超過を示唆する。",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 38 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
          "expr": "sum(increase(external_api_retry_total[1h])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ]
}
