  "refresh": "1m",
  "schemaVersion": 42,
  "version": 2,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "timepicker": {},
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "クローラー",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "クローラー実行結果（直近、1=成功 / 0=エラー）",
      "description": "種別ごとの、直近1回の実行結果。KEV・OSV・JVN・DEPSCAN・CODESCAN・RUNTIME・DEPSOPS・CLEANUP など、実行記録がある全ての種別が出る。",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "crawler_last_run_success",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "エラー",
                  "color": "red"
                },
                "1": {
                  "text": "成功",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "最終実行からの経過時間",
      "description": "毎日動くクローラーが止まっていないかを確認する。30時間を超えると橙、54時間を超えると赤（1日分の実行が飛んだ状態）。",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "(time() - crawler_last_run_timestamp_seconds) / 3600",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 54
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "h",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "クローラー所要時間（秒）",
      "description": "直近の実行にかかった時間。急に長くなったら、外部 API の遅延や対象リポジトリの増加を疑う。",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "crawler_last_run_duration_seconds",
          "legendFormat": "{{crawler_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
