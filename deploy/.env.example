# deploy/.env — docker-compose.yml / Caddyfile が参照する変数（gitignore対象）
# 使い方: このファイルを deploy/.env にコピーし、値を埋める

# Caddy が HTTPS 証明書を取得するドメイン（nip.io 無料DNSを利用する場合の例）
BACKEND_DOMAIN=203.0.113.10.nip.io

# Grafana（運用監視ダッシュボード）を公開するドメイン
GRAFANA_DOMAIN=grafana.203.0.113.10.nip.io

# Grafanaの管理者ログイン（未設定時はユーザー名 admin になる）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
