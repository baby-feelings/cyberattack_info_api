# ──────────────────────────────────────────────────────────────
# .env.example — 環境変数のテンプレートファイル
# このファイルをコピーして .env を作成し、各値を設定してください。
# !! .env は Git に絶対コミットしないこと !!
# ──────────────────────────────────────────────────────────────

# ── データベース接続文字列 ──────────────────────────────────────
# 開発環境（SQLite）
DATABASE_URL=sqlite:///./cyberattack_dev.db
# 本番環境（PostgreSQL - Neon/Supabase 等のマネージドサービス）
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── API認証キー ────────────────────────────────────────────────
# 十分に長いランダム文字列を設定してください（例: openssl rand -hex 32）
# 管理者用・フルアクセス（/admin/* を含む全エンドポイント）。ブラウザに配信される
# ダッシュボード（dashboard/.env.example の VITE_PUBLIC_API_KEY）には絶対に設定しないこと。
API_KEY=your-secret-api-key-here

# 公開ダッシュボード用の読み取り専用キー（省略可。未設定時は読み取り専用エンドポイントも
# API_KEY のみで認証される）。dashboard/.env.example の VITE_PUBLIC_API_KEY と同じ値を設定する。
PUBLIC_API_KEY=your-public-read-only-api-key-here

# ── 実行環境 ──────────────────────────────────────────────────
# development: Swagger UI 有効 / SQLite 使用
# production: Swagger UI 無効 / PostgreSQL 使用
ENVIRONMENT=development

# ── CISA KEV フィード URL（通常は変更不要）─────────────────────
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ── クローラー実行時刻（UTC）──────────────────────────────────
# JST 04:00 = UTC 19:00 (前日)
CRON_HOUR_UTC=19
CRON_MINUTE_UTC=0

# ── 依存ライブラリ脆弱性スキャナー（DEPSCAN）──────────────────
# GitHub API 認証用 PAT（fine-grained: Contents Read-only 推奨 / classic: repo スコープ）
GITHUB_TOKEN=
# スキャン対象リポジトリのオーナー（GitHub ユーザー名）
GITHUB_USERNAME=baby-feelings
# JST 07:00 = UTC 22:00（KEV→OSV→JVN の後段）
DEPSCAN_CRON_HOUR_UTC=22
# DEPSCAN データの保持期間（日数）: 解決済みのままこの日数を超えたレコードのみ自動削除
DEPSCAN_RETENTION_DAYS=180
